# RaceLab — local demonstration settings. Copy to .env to override the defaults.
# These are LOCAL demo credentials. Never reuse them anywhere else.

POSTGRES_DB=racelab
POSTGRES_USER=racelab_owner
POSTGRES_PASSWORD=racelab_owner_local
RACELAB_APP_PASSWORD=racelab_app_local
RACELAB_INTERNAL_TOKEN=change-me-local-internal-token

# Resource protection
RACELAB_MAX_CONCURRENT_EXPERIMENTS=3
RACELAB_DB_POOL_SIZE=60
BFF_TIMEOUT_MS=15000
BFF_RATE_LIMIT_PER_MINUTE=600

# Published ports (all but the frontend bind to 127.0.0.1; PostgreSQL and Redis are never published)
FRONTEND_PORT=4200
BFF_PORT=3000
BACKEND_PORT=8080
BACKEND_SECONDARY_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=racelab
